void FileChanged::files::std
ignore FileChanged::files::std
emit todosChanged: Todos::effects::backend = id

goal toggleTodo: List<Todo> =
    if saved then updated else err persistenceError = "Todo konnte nicht gespeichert werden"
let saved = write_json::files::std(updated, "backend/todos.json")
let updated = todos.map(todo =>
    if todo.id == (id: Int)
    then {id: todo.id, title: todo.title: String, done: not todo.done}
    else todo
)
let todos = read_json::files::std("backend/todos.json"): List<Todo>
