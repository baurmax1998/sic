goal view: View::web = """
<main class="todo-app">
    <h1>Todo SIC</h1>
    {todoEditor::frontend(
        value: draft,
        on_change: next => draft <- next,
        on_submit: _ =>
            let created = createTodo::backend(title: draft)
            in draft <- ""
    )}
    {todoPreview::frontend(title: draft)}
    {todoList::frontend(todos: todos)}
</main>
"""

var draft: String = ""
let todos = listTodos::backend()
