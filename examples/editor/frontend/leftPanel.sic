goal leftPanel: Component::web = """
<aside class="project-panel" aria-label="Linkes Werkzeugfenster">
    <div class="tool-content project-content">
        <div class="project-titlebar">
            <strong data-workspace-name>Project</strong>
            <button title="Neue Datei" data-workspace-new>＋F</button>
            <button title="Neuer Ordner" data-workspace-new-directory>＋D</button>
            <button title="Aktualisieren" data-workspace-refresh>↻</button>
            <button title="Minimieren" sic:onclick="{on_close}">−</button>
        </div>
        <nav class="project-body" aria-label="Dateibaum">
            <ul class="file-tree workspace-tree" data-workspace-tree>
                <li class="workspace-loading">Workspace wird geladen…</li>
            </ul>
        </nav>
    </div>
    <div class="tool-content todos-content">
        <div class="project-titlebar"><strong>TODOs</strong><button sic:onclick="{on_close}">−</button></div>
        <div class="project-body">
            <div class="todo-entry"><span>Implement file loading</span><small>frontend/app.sic:12</small></div>
            <div class="todo-entry"><span>Add syntax highlighting</span><small>frontend/app.sic:28</small></div>
            <div class="todo-entry"><span>Connect compiler output</span><small>backend/effects.sic:1</small></div>
        </div>
    </div>
</aside>
"""
