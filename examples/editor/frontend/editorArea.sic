goal editorArea: Component::web = """
<section class="editor-panel">
    <div class="tabs">
        <div class="editor-tab">
            <span class="sic-icon">S</span>
            <span>app.sic</span>
            <span class="close">×</span>
        </div>
    </div>
    <div class="editor-canvas">
        <div class="line-numbers" aria-hidden="true">1</div>
        <textarea
            class="source-editor"
            aria-label="SIC-Quelltext"
            spellcheck="false"
            sic:bind-value="{source: String}"
            sic:oninput="{on_change}"
        ></textarea>
    </div>
</section>
"""
