goal bottomPanel: Component::web = """
<section class="bottom-panel" aria-label="Ausgabe">
    <div class="bottom-left">
        <div class="bottom-content console-content">
            <div class="bottom-titlebar"><strong>Console</strong><button title="Schließen" sic:onclick="{close_left}">×</button></div>
            <pre class="console-screen">SIC Console
&gt; _</pre>
        </div>
        <div class="bottom-content debug-content">
            <div class="bottom-titlebar">
                <strong data-debug-title>Debug</strong>
                <div class="debug-actions" aria-label="Debug-Aktionen">
                    <button class="continue" title="Fortsetzen" data-debug-action="continue">▶</button>
                    <button title="Schritt über" data-debug-action="step">↷</button>
                    <button class="stop" title="Stoppen" data-debug-action="stop">■</button>
                </div>
                <button title="Schließen" sic:onclick="{close_left}">×</button>
            </div>
            <div class="debug-layout">
                <div class="debug-section debug-frames">
                    <strong>Threads & Frames</strong>
                    <ul class="debug-tree" data-debug-frames>
                        <li>Kein aktiver Debug-Lauf</li>
                    </ul>
                </div>
                <div class="resize-handle resize-debug resize-debug-frames" data-resize="debug-frames" aria-hidden="true"></div>
                <div class="debug-section debug-variables-section">
                    <strong>Variables</strong>
                    <div class="debug-variables" data-debug-variables>
                        <div class="debug-row"><span class="debug-name">–</span><span class="debug-value">Keine Werte</span></div>
                    </div>
                </div>
                <div class="resize-handle resize-debug resize-debug-variables" data-resize="debug-variables" aria-hidden="true"></div>
                <div class="debug-section debug-log-section">
                    <strong>Log Output</strong>
                    <pre class="debug-log" data-debug-log>Starte ein Goal mit D.</pre>
                </div>
            </div>
        </div>
        <div class="bottom-content run-content">
            <div class="bottom-titlebar"><strong data-run-title>Run</strong><button title="Schließen" sic:onclick="{close_left}">×</button></div>
            <pre class="console-screen" data-run-output>Wähle ein Goal und starte es mit ▶.</pre>
        </div>
    </div>
    <div class="bottom-right">
        <div class="bottom-content make-bottom-content">
            <div class="bottom-titlebar"><strong>Make</strong><button title="Schließen" sic:onclick="{close_right}">×</button></div>
            <div class="project-body">
                <div class="make-entry"><span class="target">editor</span><span class="play">▶</span><small>Editor starten</small></div>
                <div class="make-entry"><span class="target">test</span><span class="play">▶</span><small>Tests ausführen</small></div>
                <div class="make-entry"><span class="target">build</span><span class="play">▶</span><small>Webanwendung bauen</small></div>
            </div>
        </div>
        <div class="bottom-content terminal-right-content">
            <div class="bottom-titlebar">
                <div class="terminal-tabs"><span class="active">Terminal 2</span><span>＋</span></div>
                <button title="Schließen" sic:onclick="{close_right}">×</button>
            </div>
            <pre class="console-screen">SIC Terminal 2
$ pwd
/Users/project/examples/editor
$ _</pre>
        </div>
    </div>
    <div class="resize-handle resize-bottom-split" data-resize="bottom-split" aria-hidden="true"></div>
</section>
"""
