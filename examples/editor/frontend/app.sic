22
23
24</div>
            <textarea
                class="source-editor"
                aria-label="SIC-Quelltext"
                spellcheck="false"
                sic:bind-value="{source}"
                sic:oninput="{next => source <- next}"
            >{source: String}</textarea>
        </div>
    </section>

    <aside class="right-panel" aria-label="Rechtes Werkzeugfenster">
        <div class="tool-content structure-content">
            <div class="project-titlebar"><strong>Structure</strong><button sic:onclick="{_ => rightTool <- ""}">−</button></div>
            <ul class="tool-list">
                <li>◇ greeting: String</li>
                <li>◇ prefix: String</li>
                <li>◇ name: String</li>
            </ul>
        </div>
        <div class="tool-content notifications-content">
            <div class="project-titlebar"><strong>Notifications</strong><button sic:onclick="{_ => rightTool <- ""}">−</button></div>
            <div class="tool-empty">Keine neuen Benachrichtigungen</div>
        </div>
    </aside>
    <div class="resize-handle resize-right" data-resize="right" aria-hidden="true"></div>

    <aside class="tool-stripe right" aria-label="Rechte Werkzeugfenster">
        <button class="{if rightTool == "structure" then "active" else ""}" title="Structure" sic:onclick="{_ => rightTool <- if rightTool == "structure" then "" else "structure"}">⌘</button>
        <button class="{if rightTool == "notifications" then "active" else ""}" title="Notifications" sic:onclick="{_ => rightTool <- if rightTool == "notifications" then "" else "notifications"}">◉</button>
        <span class="spacer"></span>
        <button class="{if rightBottomTool == "make" then "active" else ""}" title="Make" sic:onclick="{_ => rightBottomTool <- if rightBottomTool == "make" then "" else "make"}">M</button>
        <button class="{if rightBottomTool == "terminal" then "active" else ""}" title="Terminal 2" sic:onclick="{_ => rightBottomTool <- if rightBottomTool == "terminal" then "" else "terminal"}">›_</button>
    </aside>

    <section class="bottom-panel" aria-label="Ausgabe">
        <div class="bottom-left">
            <div class="bottom-content console-content">
                <div class="bottom-titlebar"><strong>Console</strong><button title="Schließen" sic:onclick="{_ => bottomTool <- ""}">×</button></div>
                <pre class="console-screen">SIC Console
&gt; _</pre>
            </div>
            <div class="bottom-content debug-content">
                <div class="bottom-titlebar">
                    <strong>Debug: app.sic</strong>
                    <div class="debug-actions" aria-label="Debug-Aktionen">
                        <span class="continue" title="Resume">▶</span>
                        <span title="Pause">Ⅱ</span>
                        <span title="Step Over">↷</span>
                        <span title="Step Into">↓</span>
                        <span title="Step Out">↑</span>
                        <span class="stop" title="Stop">■</span>
                    </div>
                    <button title="Schließen" sic:onclick="{_ => bottomTool <- ""}">×</button>
                </div>
                <div class="debug-layout">
                    <div class="debug-section debug-frames">
                        <strong>Threads & Frames</strong>
                        <ul class="debug-tree">
                            <li>▾ Main Thread</li>
