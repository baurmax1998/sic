                    </div>
                    <div class="resize-handle resize-debug resize-debug-frames" data-resize="debug-frames" aria-hidden="true"></div>
                    <div class="debug-section debug-variables-section">
                        <strong>Variables</strong>
                        <div class="debug-variables">
                            <div class="debug-row"><span class="debug-name">source</span><span class="debug-value">"goal greeting: String = …" <span class="debug-type">String</span></span></div>
                            <div class="debug-row"><span class="debug-name">prefix</span><span class="debug-value">"Hallo " <span class="debug-type">String</span></span></div>
                            <div class="debug-row"><span class="debug-name">name</span><span class="debug-value">"SIC" <span class="debug-type">String</span></span></div>
                            <div class="debug-row"><span class="debug-name">leftTool</span><span class="debug-value">"project" <span class="debug-type">String</span></span></div>
                        </div>
                        <div class="debug-subtitle">Watches</div>
                        <div class="debug-row"><span>source</span><span class="debug-value">String</span></div>
