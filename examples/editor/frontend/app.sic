            <textarea
                class="source-editor"
                aria-label="SIC-Quelltext"
                spellcheck="false"
                sic:bind-value="{source}"
                sic:oninput="{next => source <- next}"
            >{source: String}</textarea>
        </div>
    </section>

    <aside class="tool-stripe right" aria-label="Rechte Werkzeugfenster">
        <button title="Notifications">◉</button>
        <button title="Database">▤</button>
        <span class="spacer"></span>
        <button title="AI Assistant">✦</button>
    </aside>

    <footer class="statusbar">
        <span class="path">editor</span>
        <span class="path-separator">›</span>
        <span class="path">frontend</span>
        <span class="path-separator">›</span>
        <span class="path">app.sic</span>
        <span class="status-spacer"></span>
        <div class="status-actions" aria-label="Editor-Aktionen">
            <button class="run" title="Run">▶</button>
            <button class="run-config" title="Run Configuration"><span>app.sic</span><span>▾</span></button>
            <button class="debug" title="Debug">D</button>
            <button title="Search">⌕</button>
            <button title="Settings">⚙</button>
        </div>
    </footer>
</main>
