            <button title="Search">⌕</button>
            <button title="Settings">⚙</button>
        </div>
    </footer>
</main>
<script>
(() => {{
    const root = document.documentElement;
    const properties = {{
        left: "--left-panel-width",
        right: "--right-panel-width",
        bottom: "--bottom-panel-height",
        "bottom-split": "--bottom-left-width",
        "debug-frames": "--debug-frames-width",
        "debug-variables": "--debug-variables-width"
    }};
    for (const [name, property] of Object.entries(properties)) {{
        const saved = localStorage.getItem(`sic-editor-${{name}}-size`);
        if (saved) root.style.setProperty(property, `${{saved}}px`);
    }}
    if (window.__sicEditorResizeInstalled) return;
    window.__sicEditorResizeInstalled = true;

    document.addEventListener("pointerdown", event => {{
        const handle = event.target.closest("[data-resize]");
        if (!handle) return;
        const kind = handle.dataset.resize;
        const shell = handle.closest(".ide-shell");
        if (!shell || !properties[kind]) return;
        event.preventDefault();
        handle.classList.add("dragging");
        handle.setPointerCapture?.(event.pointerId);

        const move = moveEvent => {{
            const bounds = shell.getBoundingClientRect();
            let size;
            let minimum = 120;
            let maximum;
            if (kind === "left") {{
                size = moveEvent.clientX - bounds.left - 33;
                maximum = bounds.width * 0.4;
            }} else if (kind === "right") {{
                size = bounds.right - moveEvent.clientX - 33;
                maximum = bounds.width * 0.4;
            }} else if (kind === "bottom") {{
                size = bounds.bottom - moveEvent.clientY - 25;
                minimum = 80;
                maximum = bounds.height * 0.7;
            }} else if (kind === "bottom-split") {{
                const panelBounds = handle.closest(".bottom-panel").getBoundingClientRect();
                size = moveEvent.clientX - panelBounds.left;
                maximum = panelBounds.width - minimum;
            }} else if (kind === "debug-frames") {{
                const debugBounds = handle.closest(".debug-layout").getBoundingClientRect();
                minimum = 90;
                size = moveEvent.clientX - debugBounds.left;
                maximum = debugBounds.width - 220;
            }} else {{
                const debugLayout = handle.closest(".debug-layout");
                const debugBounds = debugLayout.getBoundingClientRect();
                const frameBounds = debugLayout.querySelector(".debug-frames").getBoundingClientRect();
                minimum = 100;
                size = moveEvent.clientX - frameBounds.right;
                maximum = debugBounds.right - frameBounds.right - 100;
            }}
            size = Math.round(Math.max(minimum, Math.min(maximum, size)));
            root.style.setProperty(properties[kind], `${{size}}px`);
            localStorage.setItem(`sic-editor-${{kind}}-size`, String(size));
        }};
        const stop = () => {{
            handle.classList.remove("dragging");
            document.removeEventListener("pointermove", move);
            document.removeEventListener("pointerup", stop);
            document.removeEventListener("pointercancel", stop);
        }};
        document.addEventListener("pointermove", move);
        document.addEventListener("pointerup", stop);
        document.addEventListener("pointercancel", stop);
    }});
}})();
</script>
"""

var source: String = "goal greeting: String = prefix + name\nlet prefix = \"Hallo \"\nlet name = \"SIC\""
var leftTool: String = "project"
var rightTool: String = ""
var bottomTool: String = ""
var rightBottomTool: String = ""
