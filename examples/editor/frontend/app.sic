goal editor: View::web = """
<style>
    :root {{
        color-scheme: dark;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        --left-panel-width: 13rem;
        --right-panel-width: 13rem;
        --bottom-panel-height: 12rem;
        --bottom-left-width: 50%;
        --debug-frames-width: 12rem;
        --debug-variables-width: 20rem;
        background: #2b2b2b;
        color: #bbbbbb;
    }}
    * {{ box-sizing: border-box; }}
    html, body {{ height: 100%; }}
    body {{ margin: 0; overflow: hidden; }}
    button, textarea {{ font: inherit; }}
    button {{ color: inherit; }}
    .ide-shell {{
        display: grid;
        grid-template-columns: 2.05rem var(--left-panel-width) minmax(30rem, 1fr) var(--right-panel-width) 2.05rem;
        grid-template-rows: minmax(0, 1fr) 0 1.55rem;
        width: 100vw;
        height: 100vh;
        background: #2b2b2b;
        font-size: 0.78rem;
    }}
    .ide-shell > sic-component {{ display: contents; }}
    .tool-stripe {{
        display: flex;
        flex-direction: column;
        align-items: stretch;
        min-height: 0;
        background: #3c3f41;
        border-color: #515151;
    }}
    .tool-stripe.left {{ grid-column: 1; grid-row: 1 / 3; border-right: 1px solid #515151; }}
    .tool-stripe.right {{ grid-column: 5; grid-row: 1 / 3; border-left: 1px solid #515151; }}
    .tool-stripe button {{
        display: grid;
        place-items: center;
        width: 100%;
        min-height: 2.15rem;
        padding: 0;
        border: 0;
        background: transparent;
        color: #a7a7a7;
        cursor: pointer;
        font-size: 0.9rem;
    }}
    .tool-stripe button:hover {{ background: #4b4d4f; color: #e8e8e8; }}
    .tool-stripe button.active {{
        background: #4b4d4f;
        color: #f0f0f0;
        box-shadow: inset 2px 0 #589df6;
    }}
    .tool-stripe.right button.active {{ box-shadow: inset -2px 0 #589df6; }}
    .tool-stripe .spacer {{ flex: 1; }}
    .project-panel, .right-panel {{
        min-width: 0;
        min-height: 0;
        overflow: hidden;
        background: #3c3f41;
    }}
    .project-panel {{ grid-column: 2; grid-row: 1; border-right: 1px solid #515151; }}
    .right-panel {{ grid-column: 4; grid-row: 1; border-left: 1px solid #515151; }}
    .tool-content {{
        display: none;
        grid-template-rows: 2.2rem minmax(0, 1fr);
        width: 100%;
        height: 100%;
        min-height: 0;
    }}
    .left-project .project-content,
    .left-todos .todos-content,
    .right-structure .structure-content,
    .right-notifications .notifications-content {{ display: grid; }}
    .ide-shell.left-closed {{ grid-template-columns: 2.05rem 0 minmax(30rem, 1fr) var(--right-panel-width) 2.05rem; }}
    .ide-shell.right-closed {{ grid-template-columns: 2.05rem var(--left-panel-width) minmax(30rem, 1fr) 0 2.05rem; }}
    .ide-shell.left-closed.right-closed {{ grid-template-columns: 2.05rem 0 minmax(30rem, 1fr) 0 2.05rem; }}
    .project-titlebar {{
        display: flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0 0.45rem 0 0.65rem;
        border-bottom: 1px solid #515151;
        color: #d6d6d6;
        font-weight: 600;
    }}
    .project-titlebar strong {{ flex: 1; font-weight: 600; }}
    .project-titlebar button {{
        width: 1.45rem;
        height: 1.45rem;
        padding: 0;
        border: 0;
        border-radius: 3px;
        background: transparent;
        color: #a6a6a6;
    }}
    .project-titlebar button:hover {{ background: #505254; color: white; }}
    .project-body {{ min-height: 0; overflow: auto; padding-top: 0.25rem; }}
    .tool-list {{ margin: 0; padding: 0.4rem; list-style: none; }}
    .tool-list li {{ padding: 0.45rem 0.55rem; border-radius: 3px; color: #c8c8c8; }}
    .tool-list li:hover {{ background: #47494b; }}
    .tool-empty {{
        display: grid;
        place-items: center;
        min-height: 100%;
        padding: 1rem;
        color: #8f8f8f;
        text-align: center;
    }}
    .todo-entry, .make-entry {{
        display: grid;
        gap: 0.2rem;
        margin: 0.35rem 0.5rem;
        padding: 0.5rem;
        border-radius: 3px;
        background: #353739;
    }}
    .todo-entry small, .make-entry small {{ color: #8f8f8f; }}
    .make-entry {{ grid-template-columns: 1fr auto; align-items: center; }}
    .make-entry small {{ grid-column: 1 / -1; }}
    .make-entry .target {{ color: #ffc66d; font-family: monospace; }}
    .make-entry .play {{ color: #62b543; }}
    .file-tree, .file-tree ul {{ margin: 0; padding: 0; list-style: none; }}
    .file-tree details > summary {{
        min-height: 1.55rem;
        padding: 0.22rem 0.45rem;
        cursor: default;
        color: #c8c8c8;
        font-size: 0.78rem;
        font-weight: 500;
        user-select: none;
        white-space: nowrap;
    }}
    .file-tree details > summary:hover, .file-tree-file:hover {{ background: #47494b; }}
    .file-tree details > ul {{ padding-left: 0.9rem; }}
    .file-tree-file {{
        display: flex;
        align-items: center;
        gap: 0.38rem;
        width: 100%;
        min-height: 1.55rem;
        padding: 0.22rem 0.55rem;
        border: 0;
        background: transparent;
        color: #c8c8c8;
        text-align: left;
        white-space: nowrap;
        cursor: default;
    }}
    .file-tree-file::before {{
        content: "S";
        display: inline-grid;
        place-items: center;
        width: 0.9rem;
        height: 0.9rem;
        border-radius: 2px;
        background: #6a8759;
        color: #f2f2f2;
        font-size: 0.58rem;
        font-weight: 700;
    }}
    .file-tree-file.markdown::before {{ content: "M"; background: #4a88c7; }}
    .workspace-file-row, .file-tree details > summary {{ position: relative; }}
    .workspace-entry-name {{ padding-right: 1.5rem; }}
    .workspace-more {{
        position: absolute;
        top: 50%;
        right: 0.2rem;
        z-index: 2;
        width: 1.35rem;
        height: 1.25rem;
        padding: 0;
        transform: translateY(-50%);
        border: 0;
        border-radius: 3px;
        background: transparent;
        color: #9b9b9b;
        font-weight: 700;
        line-height: 1;
    }}
    .workspace-more:hover, .workspace-more[aria-expanded="true"] {{
        background: #5a5d60;
        color: #ffffff;
    }}
    .workspace-context-menu {{
        position: fixed;
        z-index: 1200;
        min-width: 11rem;
        padding: 0.25rem;
        border: 1px solid #5b5d5f;
        border-radius: 4px;
        background: #3c3f41;
        box-shadow: 0 0.45rem 1.2rem rgb(0 0 0 / 0.5);
    }}
    .workspace-context-menu button {{
        display: block;
        width: 100%;
        padding: 0.38rem 0.6rem;
        border: 0;
        border-radius: 3px;
        background: transparent;
        color: #d5d5d5;
        text-align: left;
    }}
    .workspace-context-menu button:hover {{ background: #4b6eaf; color: white; }}
    .workspace-context-menu .danger {{ color: #ff8b88; }}
    .workspace-context-menu[hidden] {{ display: none; }}
    .run-goal-menu {{
        position: fixed;
        z-index: 1200;
        min-width: 14rem;
        max-height: 18rem;
        overflow: auto;
        padding: 0.25rem;
        border: 1px solid #5b5d5f;
        border-radius: 4px;
        background: #3c3f41;
        box-shadow: 0 0.45rem 1.2rem rgb(0 0 0 / 0.5);
    }}
    .run-goal-menu button {{
        display: grid;
        width: 100%;
        padding: 0.38rem 0.6rem;
        border: 0;
        border-radius: 3px;
        background: transparent;
        color: #d5d5d5;
        text-align: left;
    }}
    .run-goal-menu button:hover, .run-goal-menu button.selected {{ background: #4b6eaf; color: white; }}
    .run-goal-menu small {{ color: #999999; }}
    .run-goal-menu[hidden] {{ display: none; }}
    .file-tree-file.active {{ background: #4b6eaf; color: #ffffff; }}
    .file-tree-file.workspace-selected, .file-tree summary.workspace-selected {{
        outline: 1px solid #6684b7;
        outline-offset: -1px;
        background: #3d4b61;
    }}
    .workspace-loading {{ padding: 0.5rem 0.75rem; color: #8f8f8f; }}
    .editor-tab.dirty .close {{ color: #d9a343; }}
    .save-status {{ color: #888888; }}
    .save-status.error {{ color: #ff6b68; }}
    .save-status.saved {{ color: #6a8759; }}
    .editor-panel {{
        grid-column: 3;
        grid-row: 1;
        display: grid;
        grid-template-rows: 2.2rem minmax(0, 1fr);
        min-width: 0;
        min-height: 0;
        background: #2b2b2b;
    }}
    .tabs {{
        display: flex;
        align-items: end;
        border-bottom: 1px solid #515151;
        background: #3c3f41;
    }}
    .editor-tab {{
        display: flex;
        align-items: center;
        gap: 0.45rem;
        height: 100%;
        min-width: 10rem;
        padding: 0 0.65rem;
        border-right: 1px solid #515151;
        border-top: 2px solid #589df6;
        background: #2b2b2b;
        color: #dedede;
    }}
    .sic-icon {{
        display: inline-grid;
        place-items: center;
        width: 0.9rem;
        height: 0.9rem;
        border-radius: 2px;
        background: #6a8759;
        color: white;
        font-size: 0.58rem;
        font-weight: 700;
    }}
    .editor-tab .close {{ margin-left: auto; color: #8c8c8c; font-size: 1rem; }}
    .editor-canvas {{
        display: grid;
        grid-template-columns: 3.4rem minmax(0, 1fr);
        min-width: 0;
        min-height: 0;
        background: #2b2b2b;
    }}
    .line-numbers {{
        min-height: 0;
        padding: 0.75rem 0.75rem 0.75rem 0;
        overflow: hidden;
        border-right: 1px solid #313335;
        color: #606366;
        background: #313335;
        text-align: right;
        white-space: pre;
        user-select: none;
        pointer-events: auto;
        font: 0.88rem/1.55 "JetBrains Mono", "SFMono-Regular", Consolas, monospace;
    }}
    .line-number {{ display: block; min-height: 1.55em; cursor: pointer; }}
    .line-number.breakpoint {{ color: #ffffff; }}
    .line-number.breakpoint::before {{ content: "●"; color: #d64f4b; margin-right: 0.3rem; }}
    .line-number.debug-current {{ background: #665b2f; color: #ffffff; }}
    .editor-input {{ position: relative; min-width: 0; min-height: 0; overflow: visible; }}
    .highlight-layer, .source-editor {{
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        margin: 0;
        padding: 0.75rem 1rem;
        border: 0;
        font: 0.88rem/1.55 "JetBrains Mono", "SFMono-Regular", Consolas, monospace;
        tab-size: 4;
        white-space: pre;
    }}
    .highlight-layer {{
        z-index: 1;
        overflow: hidden;
        background: #2b2b2b;
        color: #a9b7c6;
        pointer-events: none;
    }}
    .source-editor {{
        z-index: 2;
        min-width: 0;
        min-height: 0;
        resize: none;
        outline: none;
        overflow: auto;
        background: transparent;
        color: transparent;
        -webkit-text-fill-color: transparent;
        caret-color: #f8f8f0;
    }}
    .source-editor::selection {{
        background: rgb(33 66 131 / 0.68);
        color: #ffffff;
        -webkit-text-fill-color: #ffffff;
    }}
    .tok-keyword {{ color: #cc7832; font-weight: 600; }}
    .tok-string {{ color: #6a8759; }}
    .tok-number {{ color: #6897bb; }}
    .tok-comment {{ color: #808080; font-style: italic; }}
    .tok-operator {{ color: #cc7832; }}
    .tok-type {{ color: #ffc66d; }}
    .tok-function, .tok-method {{ color: #ffc66d; }}
    .tok-property {{ color: #9876aa; }}
    .tok-parameter {{ color: #a9b7c6; font-style: italic; }}
    .tok-constant {{ color: #9876aa; font-weight: 600; }}
    .tok-namespace {{ color: #a9b7c6; }}
    .tok-invalid, .tok-diagnostic {{
        text-decoration-line: underline;
        text-decoration-style: wavy;
        text-decoration-color: #ff5f56;
        text-underline-offset: 3px;
    }}
    .tok-usage {{ background: #3b514d; border-radius: 2px; }}
    .diagnostic-tooltip {{
        position: fixed;
        z-index: 1100;
        max-width: min(30rem, calc(100vw - 1rem));
        padding: 0.45rem 0.65rem;
        border: 1px solid #70504f;
        border-radius: 4px;
        background: #4a3434;
        box-shadow: 0 0.4rem 1rem rgb(0 0 0 / 0.45);
        color: #f2dede;
        pointer-events: none;
        white-space: normal;
        font: 0.78rem/1.4 -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }}
    .diagnostic-tooltip::before {{
        content: "Fehler";
        display: block;
        margin-bottom: 0.15rem;
        color: #ff7774;
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: uppercase;
    }}
    .diagnostic-tooltip[hidden] {{ display: none; }}
    .autocomplete {{
        position: fixed;
        z-index: 1000;
        width: 18rem;
        max-height: 15rem;
        overflow: auto;
        padding: 0.2rem;
        border: 1px solid #5b5d5f;
        border-radius: 4px;
        background: #3c3f41;
        box-shadow: 0 0.45rem 1.2rem rgb(0 0 0 / 0.45);
        color: #d5d5d5;
        font: 0.78rem/1.4 -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }}
    .autocomplete[hidden] {{ display: none; }}
    .autocomplete-item {{
        display: grid;
        grid-template-columns: 1.25rem minmax(0, 1fr) auto;
        align-items: center;
        gap: 0.35rem;
        min-height: 1.65rem;
        padding: 0.2rem 0.4rem;
        border-radius: 3px;
        cursor: default;
    }}
    .autocomplete-item.selected {{ background: #4b6eaf; color: white; }}
    .autocomplete-icon {{
        display: grid;
        place-items: center;
        width: 1rem;
        height: 1rem;
        border-radius: 2px;
        background: #365880;
        color: white;
        font-size: 0.6rem;
        font-weight: 700;
    }}
    .autocomplete-item[data-kind="keyword"] .autocomplete-icon {{ background: #9b623c; }}
    .autocomplete-item[data-kind="type"] .autocomplete-icon {{ background: #9b813c; }}
    .autocomplete-item[data-kind="variable"] .autocomplete-icon {{ background: #6b5680; }}
    .autocomplete-kind {{ color: #929292; font-size: 0.68rem; }}
    .autocomplete-item.selected .autocomplete-kind {{ color: #d9e6f7; }}
    .bottom-panel {{
        grid-column: 2 / 5;
        grid-row: 2;
        display: none;
        min-width: 0;
        min-height: 0;
        border-top: 1px solid #515151;
        background: #2b2b2b;
    }}
    .bottom-open {{ grid-template-rows: minmax(0, 1fr) var(--bottom-panel-height) 1.55rem; }}
    .bottom-open .bottom-panel {{
        display: grid;
        grid-template-columns: minmax(0, 1fr);
    }}
    .bottom-split .bottom-panel {{
        grid-template-columns: var(--bottom-left-width) minmax(0, 1fr);
    }}
    .resize-handle {{
        z-index: 20;
        touch-action: none;
        user-select: none;
    }}
    .resize-handle::after {{
        content: "";
        display: block;
        width: 100%;
        height: 100%;
        background: transparent;
        transition: background 120ms ease;
    }}
    .resize-handle:hover::after, .resize-handle.dragging::after {{ background: #589df6; }}
    .resize-left, .resize-right {{
        grid-row: 1;
        width: 5px;
        min-height: 0;
        cursor: col-resize;
    }}
    .resize-left {{ grid-column: 2; justify-self: end; transform: translateX(2px); }}
    .resize-right {{ grid-column: 4; justify-self: start; transform: translateX(-2px); }}
    .left-closed .resize-left, .right-closed .resize-right {{ display: none; }}
    .resize-bottom {{
        display: none;
        grid-column: 2 / 5;
        grid-row: 2;
        align-self: start;
        width: 100%;
        height: 5px;
        cursor: row-resize;
        transform: translateY(-2px);
    }}
    .bottom-open .resize-bottom {{ display: block; }}
    .resize-bottom-split {{
        display: none;
        grid-column: 1;
        grid-row: 1;
        justify-self: end;
        width: 5px;
        height: 100%;
        cursor: col-resize;
        transform: translateX(2px);
    }}
    .bottom-split .resize-bottom-split {{ display: block; }}
    .bottom-left, .bottom-right {{
        display: none;
        grid-column: 1;
        grid-row: 1;
        min-width: 0;
        min-height: 0;
    }}
    .bottom-split .bottom-right {{ grid-column: 2; }}
    .bottom-console .bottom-left,
    .bottom-debug .bottom-left,
    .bottom-run .bottom-left,
    .bottom-make .bottom-right,
    .bottom-terminal .bottom-right {{ display: block; }}
    .bottom-split .bottom-right {{ border-left: 1px solid #515151; }}
    .bottom-content {{
        display: none;
        grid-template-rows: 2rem minmax(0, 1fr);
        width: 100%;
        height: 100%;
        min-height: 0;
    }}
    .bottom-console .console-content,
    .bottom-debug .debug-content,
    .bottom-run .run-content,
    .bottom-make .make-bottom-content,
    .bottom-terminal .terminal-right-content {{ display: grid; }}
    .bottom-titlebar {{
        display: flex;
        align-items: center;
        padding: 0 0.55rem;
        border-bottom: 1px solid #454545;
        background: #3c3f41;
    }}
    .bottom-titlebar strong {{ flex: 1; }}
    .bottom-titlebar button {{ border: 0; background: transparent; color: #aaaaaa; font-size: 1rem; }}
    .console-screen {{
        margin: 0;
        padding: 0.65rem 0.8rem;
        overflow: auto;
        color: #b8c7a3;
        font: 0.8rem/1.5 "JetBrains Mono", Consolas, monospace;
    }}
    .debug-actions {{
        display: flex;
        align-items: center;
        gap: 0.15rem;
        margin-right: 0.45rem;
    }}
    .debug-actions button {{
        display: grid;
        place-items: center;
        min-width: 1.35rem;
        height: 1.35rem;
        padding: 0;
        border: 0;
        border-radius: 3px;
        background: transparent;
        color: #bdbdbd;
    }}
    .debug-actions button:hover {{ background: #505254; }}
    .debug-actions .continue {{ color: #62b543; }}
    .debug-actions .stop {{ color: #d65c5c; }}
    .debug-layout {{
        display: grid;
        grid-template-columns: var(--debug-frames-width) var(--debug-variables-width) minmax(8rem, 1fr);
        min-width: 0;
        min-height: 0;
        color: #c8c8c8;
    }}
    .debug-section {{ min-width: 0; padding: 0.55rem; border-right: 1px solid #454545; overflow: auto; }}
    .debug-frames {{ grid-column: 1; grid-row: 1; }}
    .debug-variables-section {{ grid-column: 2; grid-row: 1; }}
    .debug-log-section {{ grid-column: 3; grid-row: 1; }}
    .resize-debug {{
        grid-row: 1;
        justify-self: end;
        width: 5px;
        height: 100%;
        cursor: col-resize;
        transform: translateX(2px);
    }}
    .resize-debug-frames {{ grid-column: 1; }}
    .resize-debug-variables {{ grid-column: 2; }}
    .debug-section:last-child {{ border-right: 0; }}
    .debug-section > strong {{
        display: block;
        margin-bottom: 0.45rem;
        color: #dddddd;
        font-size: 0.72rem;
        text-transform: uppercase;
    }}
    .debug-tree, .debug-variables {{ margin: 0; padding: 0; list-style: none; }}
    .debug-tree li, .debug-row {{ padding: 0.2rem 0.3rem; border-radius: 2px; white-space: nowrap; }}
    .debug-tree li:hover, .debug-row:hover {{ background: #3d3f41; }}
    .debug-tree .selected {{ background: #4b6eaf; color: white; }}
    .debug-row {{ display: grid; grid-template-columns: minmax(6rem, 0.8fr) minmax(8rem, 1.2fr); gap: 0.6rem; }}
    .debug-name {{ color: #9876aa; }}
    .debug-value {{ color: #6a8759; overflow: hidden; text-overflow: ellipsis; }}
    .debug-type {{ color: #808080; }}
    .debug-subtitle {{
        margin: 0.75rem 0 0.35rem;
        padding-top: 0.55rem;
        border-top: 1px solid #454545;
        color: #dddddd;
        font-size: 0.72rem;
        font-weight: 600;
        text-transform: uppercase;
    }}
    .watch-add {{ margin-top: 0.35rem; color: #808080; }}
    .debug-log {{
        margin: 0;
        color: #a9b7c6;
        white-space: pre-wrap;
        font: 0.76rem/1.5 "JetBrains Mono", Consolas, monospace;
    }}
    .debug-log .info {{ color: #6897bb; }}
    .debug-log .success {{ color: #6a8759; }}
    .terminal-tabs {{
        display: flex;
        align-items: center;
        gap: 0.35rem;
        margin-right: auto;
        color: #bdbdbd;
    }}
    .terminal-tabs .active {{ padding: 0.25rem 0.4rem; border-bottom: 2px solid #589df6; color: #eeeeee; }}
    .statusbar {{
        grid-column: 1 / -1;
        grid-row: 3;
        display: flex;
        align-items: center;
        gap: 1rem;
        min-width: 0;
        padding: 0 0.5rem;
        border-top: 1px solid #515151;
        background: #3c3f41;
        color: #b6b6b6;
        font-size: 0.7rem;
        user-select: none;
    }}
    .statusbar .path {{ color: #cfcfcf; }}
    .statusbar .path-separator {{ color: #777777; }}
    .status-actions {{
        display: flex;
        align-items: center;
        gap: 0.15rem;
        height: 100%;
    }}
    .status-actions button {{
        display: grid;
        place-items: center;
        height: 1.25rem;
        min-width: 1.45rem;
        padding: 0 0.35rem;
        border: 0;
        border-radius: 3px;
        background: transparent;
        color: #c5c5c5;
        font-size: 0.72rem;
        line-height: 1;
    }}
    .status-actions button:hover {{ background: #505254; color: white; }}
    .status-actions .run {{ color: #62b543; }}
    .status-actions .run-config {{
        display: flex;
        min-width: 6.5rem;
        justify-content: space-between;
        color: #d0d0d0;
    }}
    .status-actions .debug {{ color: #7ba45d; font-weight: 700; }}
    .statusbar .status-spacer {{ flex: 1; }}
    .statusbar span {{ white-space: nowrap; }}
    @media (max-width: 1000px) {{
        .ide-shell {{ grid-template-columns: 1.8rem var(--left-panel-width) minmax(24rem, 1fr) var(--right-panel-width) 1.8rem; }}
        .ide-shell.left-closed {{ grid-template-columns: 1.8rem 0 minmax(24rem, 1fr) var(--right-panel-width) 1.8rem; }}
        .ide-shell.right-closed {{ grid-template-columns: 1.8rem var(--left-panel-width) minmax(24rem, 1fr) 0 1.8rem; }}
        .ide-shell.left-closed.right-closed {{ grid-template-columns: 1.8rem 0 minmax(24rem, 1fr) 0 1.8rem; }}
    }}
</style>
<main class="ide-shell {if leftTool == "" then "left-closed" else "left-" + leftTool} {if rightTool == "" then "right-closed" else "right-" + rightTool} {if bottomTool == "" and rightBottomTool == "" then "" else "bottom-open"} {if bottomTool == "" then "" else "bottom-" + bottomTool} {if rightBottomTool == "" then "" else "bottom-" + rightBottomTool} {if bottomTool != "" and rightBottomTool != "" then "bottom-split" else ""}">
    {leftTools::frontend(
        left_tool: leftTool,
        bottom_tool: bottomTool,
        on_project: _ => leftTool <- if leftTool == "project" then "" else "project",
        on_todos: _ => leftTool <- if leftTool == "todos" then "" else "todos",
        on_run: _ => bottomTool <- if bottomTool == "run" then "" else "run",
        on_debug: _ => bottomTool <- if bottomTool == "debug" then "" else "debug",
        on_console: _ => bottomTool <- if bottomTool == "console" then "" else "console"
    )}

    {leftPanel::frontend(on_close: _ => leftTool <- "")}
    <div class="resize-handle resize-left" data-resize="left" aria-hidden="true"></div>

    {editorArea::frontend(
        source: source,
        on_change: next => source <- next
    )}

    {rightPanel::frontend(on_close: _ => rightTool <- "")}
    <div class="resize-handle resize-right" data-resize="right" aria-hidden="true"></div>

    {rightTools::frontend(
        right_tool: rightTool,
        right_bottom_tool: rightBottomTool,
        on_structure: _ => rightTool <- if rightTool == "structure" then "" else "structure",
        on_notifications: _ => rightTool <- if rightTool == "notifications" then "" else "notifications",
        on_make: _ => rightBottomTool <- if rightBottomTool == "make" then "" else "make",
        on_terminal: _ => rightBottomTool <- if rightBottomTool == "terminal" then "" else "terminal"
    )}

    {bottomPanel::frontend(
        close_left: _ => bottomTool <- "",
        close_right: _ => rightBottomTool <- ""
    )}
    <div class="resize-handle resize-bottom" data-resize="bottom" aria-hidden="true"></div>

    {statusBar::frontend()}
</main>
<script>
(() => {{
    const root = document.documentElement;
    const properties = {{
        left: "--left-panel-width",
        right: "--right-panel-width",
        bottom: "--bottom-panel-height",
        "bottom-split": "--bottom-left-width",
        "debug-frames": "--debug-frames-width",
        "debug-variables": "--debug-variables-width"
    }};
    for (const [name, property] of Object.entries(properties)) {{
        const saved = localStorage.getItem(`sic-editor-${{name}}-size`);
        if (saved) root.style.setProperty(property, `${{saved}}px`);
    }}

    if (!window.__sicEditorLineNumbersInstalled) {{
        window.__sicEditorLineNumbersInstalled = true;
        const analysisByEditor = new WeakMap();
        const analysisVersion = new WeakMap();
        const analysisTimer = new WeakMap();
        const completionState = new WeakMap();
        window.__sicBreakpoints ||= new Map();
        const completionDefaults = [
            ["goal", "keyword"], ["let", "keyword"], ["var", "keyword"],
            ["if", "keyword"], ["then", "keyword"], ["else", "keyword"],
            ["match", "keyword"], ["in", "keyword"], ["true", "constant"],
            ["false", "constant"], ["null", "constant"], ["not", "keyword"],
            ["and", "keyword"], ["or", "keyword"], ["String", "type"],
            ["Int", "type"], ["Float", "type"], ["Bool", "type"],
            ["List", "type"], ["Map", "type"], ["map", "method"],
            ["filter", "method"], ["sum", "method"], ["first", "method"]
        ];

        const updateLineNumbers = editor => {{
            const gutter = editor.closest(".editor-canvas")?.querySelector(".line-numbers");
            if (!gutter) return;
            const lineCount = editor.value.split("\n").length;
            const path = window.__sicCurrentFile || "";
            const breakpoints = window.__sicBreakpoints.get(path) || new Set();
            const current = window.__sicDebugLocation;
            gutter.replaceChildren(...[...Array(lineCount)].map((_, index) => {{
                const line = document.createElement("span");
                line.className = "line-number";
                line.dataset.line = String(index + 1);
                line.textContent = String(index + 1);
                line.classList.toggle("breakpoint", breakpoints.has(index + 1));
                line.classList.toggle(
                    "debug-current", current?.path === path && current?.line === index + 1
                );
                return line;
            }}));
            gutter.scrollTop = editor.scrollTop;
        }};
        const syncEditorScroll = editor => {{
            const layer = editor.closest(".editor-input")?.querySelector(".highlight-layer");
            if (layer) {{
                layer.scrollTop = editor.scrollTop;
                layer.scrollLeft = editor.scrollLeft;
            }}
            updateLineNumbers(editor);
        }};
        const diagnosticTooltip = () => {{
            let tooltip = document.querySelector(".diagnostic-tooltip");
            if (!tooltip) {{
                tooltip = document.createElement("div");
                tooltip.className = "diagnostic-tooltip";
                tooltip.hidden = true;
                document.body.append(tooltip);
            }}
            return tooltip;
        }};
        const hideDiagnosticTooltip = () => diagnosticTooltip().hidden = true;
        const sourceOffsetAtPoint = (editor, event) => {{
            const bounds = editor.getBoundingClientRect();
            const style = getComputedStyle(editor);
            const lineHeight = parseFloat(style.lineHeight);
            const x = event.clientX - bounds.left - parseFloat(style.paddingLeft) + editor.scrollLeft;
            const y = event.clientY - bounds.top - parseFloat(style.paddingTop) + editor.scrollTop;
            if (x < 0 || y < 0) return null;
            const lines = editor.value.split("\n");
            const lineIndex = Math.floor(y / lineHeight);
            if (lineIndex < 0 || lineIndex >= lines.length) return null;
            const canvas = sourceOffsetAtPoint.canvas ||= document.createElement("canvas");
            const context = canvas.getContext("2d");
            context.font = style.font;
            const characterWidth = context.measureText("M").width;
            const targetColumn = x / characterWidth;
            const line = lines[lineIndex];
            let visualColumn = 0;
            let column = line.length;
            for (let index = 0; index < line.length; index++) {{
                const width = line[index] === "\t" ? 4 - visualColumn % 4 : 1;
                if (targetColumn < visualColumn + width) {{ column = index; break; }}
                visualColumn += width;
            }}
            const lineStart = lines.slice(0, lineIndex).reduce(
                (total, value) => total + value.length + 1, 0
            );
            return lineStart + column;
        }};
        const showDiagnosticTooltip = (editor, event) => {{
            const analysis = analysisByEditor.get(editor);
            if (!analysis?.diagnostics?.length) {{ hideDiagnosticTooltip(); return; }}
            const offset = sourceOffsetAtPoint(editor, event);
            if (offset === null) {{ hideDiagnosticTooltip(); return; }}
            const token = analysis.tokens.find(item => item.start <= offset && offset <= item.end);
            const diagnostic = token
                ? analysis.diagnostics.find(item => item.start < token.end && item.end >= token.start)
                : analysis.diagnostics.find(item => item.start <= offset && offset <= Math.max(item.end, item.start + 1));
            if (!diagnostic) {{ hideDiagnosticTooltip(); return; }}
            const tooltip = diagnosticTooltip();
            tooltip.textContent = diagnostic.message;
            tooltip.hidden = false;
            const tooltipBounds = tooltip.getBoundingClientRect();
            let left = event.clientX + 14;
            let top = event.clientY + 18;
            if (left + tooltipBounds.width > window.innerWidth - 8)
                left = window.innerWidth - tooltipBounds.width - 8;
            if (top + tooltipBounds.height > window.innerHeight - 8)
                top = event.clientY - tooltipBounds.height - 10;
            tooltip.style.left = `${{Math.max(8, left)}}px`;
            tooltip.style.top = `${{Math.max(8, top)}}px`;
        }};
        const highlightUsages = editor => {{
            const layer = editor.closest(".editor-input")?.querySelector(".highlight-layer");
            const analysis = analysisByEditor.get(editor);
            if (!layer || !analysis) return;
            layer.querySelectorAll(".tok-usage").forEach(node => node.classList.remove("tok-usage"));
            const position = editor.selectionStart;
            const token = analysis.tokens.find(item =>
                item.symbol && item.start <= position && position <= item.end
            );
            if (!token) return;
            layer.querySelectorAll("[data-symbol]").forEach(node => {{
                if (node.dataset.symbol === token.symbol) node.classList.add("tok-usage");
            }});
        }};
        const completionContext = (editor, manual = false) => {{
            if (editor.selectionStart !== editor.selectionEnd) return null;
            const before = editor.value.slice(0, editor.selectionStart);
            const match = before.match(/[A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*(?:::)?$/);
            if (!match && !manual) return null;
            return {{
                start: match ? editor.selectionStart - match[0].length : editor.selectionStart,
                prefix: match ? match[0] : ""
            }};
        }};
        const positionAutocomplete = (editor, dropdown) => {{
            const style = getComputedStyle(editor);
            const before = editor.value.slice(0, editor.selectionStart).split("\n");
            let column = 0;
            for (const character of before.at(-1))
                column += character === "\t" ? 4 - column % 4 : 1;
            const canvas = positionAutocomplete.canvas ||= document.createElement("canvas");
            const context = canvas.getContext("2d");
            context.font = style.font;
            const characterWidth = context.measureText("M").width;
            const lineHeight = parseFloat(style.lineHeight);
            const bounds = editor.getBoundingClientRect();
            let left = bounds.left + parseFloat(style.paddingLeft) + column * characterWidth - editor.scrollLeft;
            let top = bounds.top + parseFloat(style.paddingTop) + before.length * lineHeight - editor.scrollTop;
            left = Math.min(left, window.innerWidth - 300);
            top = Math.min(top, window.innerHeight - 260);
            dropdown.style.left = `${{Math.max(4, left)}}px`;
            dropdown.style.top = `${{Math.max(4, top)}}px`;
        }};
        const showAutocomplete = (editor, manual = false) => {{
            const dropdown = editor.closest(".editor-input")?.querySelector(".autocomplete");
            const context = completionContext(editor, manual);
            if (!dropdown || !context) {{ if (dropdown) dropdown.hidden = true; return; }}
            const analysis = analysisByEditor.get(editor);
            const candidates = new Map(
                completionDefaults.map(([label, kind]) => [label, [kind, label]])
            );
            for (const symbol of analysis?.symbols || []) {{
                const token = analysis.tokens.find(item => item.symbol === symbol.name);
                candidates.set(symbol.name, [token?.type || "variable", symbol.name]);
            }}
            for (const completion of analysis?.completions || [])
                candidates.set(completion.label, [completion.kind, completion.insertText]);
            const prefix = context.prefix.toLowerCase();
            const items = [...candidates]
                .filter(([label]) => (!prefix || label.toLowerCase().startsWith(prefix)) && label !== context.prefix)
                .sort(([left], [right]) => left.localeCompare(right))
                .slice(0, 50);
            if (!items.length) {{ dropdown.hidden = true; return; }}
            dropdown.replaceChildren();
            items.forEach(([label, [kind]], index) => {{
                const item = document.createElement("div");
                item.className = `autocomplete-item${{index === 0 ? " selected" : ""}}`;
                item.dataset.index = String(index);
                item.dataset.kind = kind;
                const icon = document.createElement("span");
                icon.className = "autocomplete-icon";
                icon.textContent = kind.slice(0, 1).toUpperCase();
                const name = document.createElement("span");
                name.textContent = label;
                const detail = document.createElement("span");
                detail.className = "autocomplete-kind";
                detail.textContent = kind;
                item.append(icon, name, detail);
                dropdown.append(item);
            }});
            completionState.set(editor, {{items, start: context.start, selected: 0}});
            dropdown.hidden = false;
            positionAutocomplete(editor, dropdown);
        }};
        const selectCompletion = (editor, direction) => {{
            const dropdown = editor.closest(".editor-input")?.querySelector(".autocomplete");
            const state = completionState.get(editor);
            if (!dropdown || !state) return;
            state.selected = (state.selected + direction + state.items.length) % state.items.length;
            dropdown.querySelectorAll(".autocomplete-item").forEach((item, index) =>
                item.classList.toggle("selected", index === state.selected)
            );
            dropdown.querySelector(".autocomplete-item.selected")?.scrollIntoView({{block: "nearest"}});
        }};
        const changeIndent = (editor, outdent = false) => {{
            const start = editor.selectionStart;
            const end = editor.selectionEnd;
            if (start === end) {{
                if (outdent) {{
                    const lineStart = editor.value.lastIndexOf("\n", start - 1) + 1;
                    const beforeCaret = editor.value.slice(lineStart, start);
                    const removable = beforeCaret.match(/(?:\t| {{1,4}})$/)?.[0] || "";
                    if (removable)
                        editor.setRangeText("", start - removable.length, start, "end");
                }} else {{
                    editor.setRangeText("    ", start, end, "end");
                }}
            }} else {{
                const blockStart = editor.value.lastIndexOf("\n", start - 1) + 1;
                let blockEnd = editor.value.indexOf("\n", end);
                if (blockEnd < 0) blockEnd = editor.value.length;
                const block = editor.value.slice(blockStart, blockEnd);
                const changed = block.split("\n").map(line =>
                    outdent ? line.replace(/^(?:\t| {{1,4}})/, "") : `    ${{line}}`
                ).join("\n");
                editor.setRangeText(changed, blockStart, blockEnd, "select");
            }}
            editor.dispatchEvent(new Event("input", {{bubbles: true}}));
        }};
        const acceptCompletion = (editor, index = null) => {{
            const dropdown = editor.closest(".editor-input")?.querySelector(".autocomplete");
            const state = completionState.get(editor);
            if (!dropdown || !state) return;
            const selected = index === null ? state.selected : index;
            const candidate = state.items[selected];
            const insertText = candidate?.[1]?.[1];
            if (!insertText) return;
            editor.setRangeText(insertText, state.start, editor.selectionStart, "end");
            dropdown.hidden = true;
            editor.dispatchEvent(new Event("input", {{bubbles: true}}));
        }};
        const renderAnalysis = (editor, analysis) => {{
            const layer = editor.closest(".editor-input")?.querySelector(".highlight-layer");
            if (!layer) return;
            const source = editor.value;
            const fragment = document.createDocumentFragment();
            let offset = 0;
            for (const token of analysis.tokens) {{
                if (token.start > offset)
                    fragment.append(document.createTextNode(source.slice(offset, token.start)));
                const span = document.createElement("span");
                span.className = `tok-${{token.type}}`;
                span.textContent = source.slice(token.start, token.end);
                span.dataset.start = String(token.start);
                span.dataset.end = String(token.end);
                if (token.symbol) span.dataset.symbol = token.symbol;
                const diagnostic = analysis.diagnostics.find(item =>
                    item.start < token.end && item.end >= token.start
                );
                if (diagnostic) {{
                    span.classList.add("tok-diagnostic");
                    span.title = diagnostic.message;
                }}
                fragment.append(span);
                offset = token.end;
            }}
            if (offset < source.length) fragment.append(document.createTextNode(source.slice(offset)));
            layer.replaceChildren(fragment);
            analysisByEditor.set(editor, analysis);
            syncEditorScroll(editor);
            highlightUsages(editor);
            const dropdown = editor.closest(".editor-input")?.querySelector(".autocomplete");
            if (dropdown && !dropdown.hidden) showAutocomplete(editor);
        }};
        const renderPendingSource = editor => {{
            const layer = editor.closest(".editor-input")?.querySelector(".highlight-layer");
            if (!layer) return;
            layer.textContent = editor.value;
            syncEditorScroll(editor);
        }};
        const requestAnalysis = editor => {{
            clearTimeout(analysisTimer.get(editor));
            const version = (analysisVersion.get(editor) || 0) + 1;
            analysisVersion.set(editor, version);
            const timer = setTimeout(async () => {{
                if (!window.sic?.analyze) {{ requestAnalysis(editor); return; }}
                try {{
                    const analysis = await window.sic.analyze(
                        editor.value, window.__sicCurrentFile || null
                    );
                    if (analysisVersion.get(editor) === version && editor.isConnected)
                        renderAnalysis(editor, analysis);
                }} catch (error) {{
                    console.error("[SIC] Quelltextanalyse fehlgeschlagen", error);
                }}
            }}, 35);
            analysisTimer.set(editor, timer);
        }};
        const updateEditor = editor => {{
            updateLineNumbers(editor);
            renderPendingSource(editor);
            requestAnalysis(editor);
        }};
        const updateAllEditors = () =>
            document.querySelectorAll(".source-editor").forEach(updateEditor);
        document.addEventListener("input", event => {{
            if (event.target.matches?.(".source-editor")) {{
                hideDiagnosticTooltip();
                updateEditor(event.target);
                showAutocomplete(event.target);
            }}
        }});
        document.addEventListener("keydown", event => {{
            const editor = event.target.matches?.(".source-editor") ? event.target : null;
            if (!editor) return;
            const dropdown = editor.closest(".editor-input")?.querySelector(".autocomplete");
            if ((event.ctrlKey || event.metaKey) && event.code === "Space") {{
                event.preventDefault();
                showAutocomplete(editor, true);
            }} else if (dropdown && !dropdown.hidden && event.key === "ArrowDown") {{
                event.preventDefault(); selectCompletion(editor, 1);
            }} else if (dropdown && !dropdown.hidden && event.key === "ArrowUp") {{
                event.preventDefault(); selectCompletion(editor, -1);
            }} else if (dropdown && !dropdown.hidden && (event.key === "Enter" || (event.key === "Tab" && !event.shiftKey))) {{
                event.preventDefault(); acceptCompletion(editor);
            }} else if (dropdown && !dropdown.hidden && event.key === "Escape") {{
                event.preventDefault(); dropdown.hidden = true;
            }} else if (event.key === "Tab") {{
                event.preventDefault();
                if (dropdown) dropdown.hidden = true;
                changeIndent(editor, event.shiftKey);
            }}
        }});
        document.addEventListener("pointerdown", event => {{
            const item = event.target.closest(".autocomplete-item");
            if (!item) {{
                if (!event.target.matches?.(".source-editor"))
                    document.querySelectorAll(".autocomplete").forEach(menu => menu.hidden = true);
                return;
            }}
            const editor = item.closest(".editor-input")?.querySelector(".source-editor");
            if (!editor) return;
            event.preventDefault();
            acceptCompletion(editor, Number(item.dataset.index));
            editor.focus();
        }});
        document.addEventListener("mousemove", event => {{
            const editor = event.target.matches?.(".source-editor") ? event.target : null;
            if (editor) showDiagnosticTooltip(editor, event);
            else hideDiagnosticTooltip();
        }});
        document.addEventListener("mouseout", event => {{
            if (event.target.matches?.(".source-editor")) hideDiagnosticTooltip();
        }});
        document.addEventListener("scroll", event => {{
            if (event.target.matches?.(".source-editor")) {{
                syncEditorScroll(event.target);
                hideDiagnosticTooltip();
            }}
        }}, true);
        document.addEventListener("click", event => {{
            const line = event.target.closest(".line-number");
            if (!line) return;
            const path = window.__sicCurrentFile;
            if (!path) return;
            const number = Number(line.dataset.line);
            const breakpoints = window.__sicBreakpoints.get(path) || new Set();
            if (breakpoints.has(number)) breakpoints.delete(number);
            else breakpoints.add(number);
            window.__sicBreakpoints.set(path, breakpoints);
            updateLineNumbers(document.querySelector(".source-editor"));
        }});
        document.addEventListener("selectionchange", () => {{
            if (document.activeElement?.matches?.(".source-editor"))
                highlightUsages(document.activeElement);
        }});
        document.addEventListener("sic:bindings-hydrated", updateAllEditors);
        requestAnimationFrame(updateAllEditors);
    }}

    if (!window.__sicWorkspaceManagerInstalled) {{
        window.__sicWorkspaceManagerInstalled = true;
        let workspaceTree = null;
        let currentFile = "";
        let selectedPath = "";
        let selectedType = "";
        window.__sicCurrentFile = "";
        let savedContent = "";
        let dirty = false;
        let workspaceGoals = [];
        let selectedGoal = null;
        let lastRunOutput = "Wähle ein Goal und starte es mit ▶.";
        let debugTrace = [];
        let debugIndex = -1;
        let debugResult = null;

        const sourceEditor = () => document.querySelector(".source-editor");
        const setSaveStatus = (text, kind = "") => {{
            document.querySelectorAll("[data-save-status]").forEach(node => {{
                node.textContent = text;
                node.className = `save-status ${{kind}}`;
            }});
        }};
        const updateFileLabels = () => {{
            const name = currentFile.split("/").at(-1) || "Keine Datei";
            document.querySelectorAll("[data-current-file]").forEach(node => node.textContent = name);
            document.querySelectorAll("[data-current-path]").forEach(node => node.textContent = currentFile || "Keine Datei");
            document.querySelectorAll(".run-config span:first-child").forEach(node =>
                node.textContent = selectedGoal?.label || "Goal wählen"
            );
            document.querySelectorAll(".editor-tab").forEach(node => node.classList.toggle("dirty", dirty));
            document.querySelectorAll("[data-dirty-indicator]").forEach(node => node.textContent = dirty ? "●" : "×");
            document.querySelectorAll("[data-workspace-file]").forEach(node =>
                node.classList.toggle(
                    "active",
                    selectedType === "file" && node.dataset.workspaceFile === selectedPath
                )
            );
            document.querySelectorAll("[data-workspace-path]").forEach(node =>
                node.classList.toggle("workspace-selected", node.dataset.workspacePath === selectedPath)
            );
        }};
        const setDirty = value => {{
            dirty = value;
            setSaveStatus(value ? "Nicht gespeichert" : "Bereit");
            updateFileLabels();
        }};
        const fileClass = name => name.endsWith(".md") ? " markdown" : "";
        const moreButton = entry => {{
            const button = document.createElement("button");
            button.className = "workspace-more";
            button.type = "button";
            button.title = `Aktionen für ${{entry.name}}`;
            button.setAttribute("aria-label", button.title);
            button.setAttribute("aria-expanded", "false");
            button.dataset.workspaceMenuPath = entry.path;
            button.dataset.workspaceMenuType = entry.type;
            button.textContent = "⋮";
            return button;
        }};
        const appendTreeEntries = (parent, entries) => {{
            for (const entry of entries) {{
                const item = document.createElement("li");
                if (entry.type === "directory") {{
                    const details = document.createElement("details");
                    details.open = true;
                    const summary = document.createElement("summary");
                    summary.dataset.workspacePath = entry.path;
                    summary.dataset.workspaceType = entry.type;
                    const name = document.createElement("span");
                    name.className = "workspace-entry-name";
                    name.textContent = entry.name;
                    summary.append(name, moreButton(entry));
                    const children = document.createElement("ul");
                    appendTreeEntries(children, entry.children || []);
                    details.append(summary, children);
                    item.append(details);
                }} else {{
                    const row = document.createElement("div");
                    row.className = "workspace-file-row";
                    const button = document.createElement("button");
                    button.className = `file-tree-file${{fileClass(entry.name)}}`;
                    button.dataset.workspaceFile = entry.path;
                    button.dataset.workspacePath = entry.path;
                    button.dataset.workspaceType = entry.type;
                    button.textContent = entry.name;
                    row.append(button, moreButton(entry));
                    item.append(row);
                }}
                parent.append(item);
            }}
        }};
        const renderWorkspace = () => {{
            if (!workspaceTree) return;
            document.querySelectorAll("[data-workspace-name], [data-workspace-label]")
                .forEach(node => node.textContent = workspaceTree.name);
            document.querySelectorAll("[data-workspace-tree]").forEach(tree => {{
                tree.replaceChildren();
                appendTreeEntries(tree, workspaceTree.children || []);
            }});
            updateFileLabels();
        }};
        const refreshGoals = async () => {{
            workspaceGoals = await window.sic.workspace.goals();
            if (selectedGoal)
                selectedGoal = workspaceGoals.find(goal => goal.path === selectedGoal.path) || null;
            if (!selectedGoal)
                selectedGoal = workspaceGoals.find(goal => goal.path === currentFile) || workspaceGoals[0] || null;
            updateFileLabels();
        }};
        const refreshWorkspace = async () => {{
            if (!window.sic?.workspace) {{ setTimeout(refreshWorkspace, 50); return; }}
            try {{
                workspaceTree = await window.sic.workspace.list();
                renderWorkspace();
                try {{
                    await refreshGoals();
                }} catch (error) {{
                    console.error("[SIC] Goals konnten nicht geladen werden", error);
                    setSaveStatus(`Goals nicht verfügbar: ${{error.message}}`, "error");
                }}
                if (!currentFile) {{
                    const first = workspaceTree.children?.find(entry => entry.type === "file" && entry.name.endsWith(".sic"));
                    if (first) await openWorkspaceFile(first.path, false);
                }}
            }} catch (error) {{
                setSaveStatus(error.message, "error");
            }}
        }};
        const openWorkspaceFile = async (path, confirmDirty = true) => {{
            if (confirmDirty && dirty && !window.confirm("Ungespeicherte Änderungen verwerfen?")) return;
            try {{
                const file = await window.sic.workspace.read(path);
                const editor = sourceEditor();
                if (!editor) return;
                currentFile = file.path;
                selectedPath = file.path;
                selectedType = "file";
                window.__sicCurrentFile = file.path;
                savedContent = file.content;
                editor.value = file.content;
                editor.setAttribute("sic:bind-value", file.content);
                editor.selectionStart = editor.selectionEnd = 0;
                setDirty(false);
                editor.dispatchEvent(new Event("input", {{bubbles: true}}));
                editor.focus();
                updateFileLabels();
            }} catch (error) {{
                setSaveStatus(error.message, "error");
            }}
        }};
        const saveWorkspaceFile = async () => {{
            const editor = sourceEditor();
            if (!editor || !currentFile) return;
            setSaveStatus("Speichert…");
            try {{
                await window.sic.workspace.write(currentFile, editor.value);
                savedContent = editor.value;
                editor.setAttribute("sic:bind-value", savedContent);
                dirty = false;
                setSaveStatus("Gespeichert", "saved");
                updateFileLabels();
            }} catch (error) {{
                setSaveStatus(error.message, "error");
            }}
        }};
        const runGoalMenu = () => {{
            let menu = document.querySelector(".run-goal-menu");
            if (!menu) {{
                menu = document.createElement("div");
                menu.className = "run-goal-menu";
                menu.hidden = true;
                document.body.append(menu);
            }}
            return menu;
        }};
        const hideRunGoalMenu = () => runGoalMenu().hidden = true;
        const showRunGoalMenu = button => {{
            const menu = runGoalMenu();
            menu.replaceChildren(...workspaceGoals.map((goal, index) => {{
                const item = document.createElement("button");
                item.type = "button";
                item.dataset.runGoal = String(index);
                item.classList.toggle("selected", selectedGoal?.path === goal.path);
                const label = document.createElement("span");
                label.textContent = goal.label;
                const detail = document.createElement("small");
                detail.textContent = goal.path;
                item.append(label, detail);
                return item;
            }}));
            if (!workspaceGoals.length) menu.textContent = "Keine ausführbaren Goals";
            menu.hidden = false;
            const bounds = button.getBoundingClientRect();
            const menuBounds = menu.getBoundingClientRect();
            menu.style.left = `${{Math.max(8, Math.min(bounds.left, window.innerWidth - menuBounds.width - 8))}}px`;
            menu.style.top = `${{Math.max(8, bounds.top - menuBounds.height - 4)}}px`;
        }};
        const parseGoalArgument = (input, raw) => {{
            if (input.type === "String") return raw;
            if (input.type === "Int") {{
                const value = Number(raw);
                if (!Number.isInteger(value)) throw new Error(`${{input.name}} erwartet Int`);
                return value;
            }}
            if (input.type === "Float") {{
                const value = Number(raw);
                if (!Number.isFinite(value)) throw new Error(`${{input.name}} erwartet Float`);
                return value;
            }}
            if (input.type === "Bool") {{
                if (raw === "true") return true;
                if (raw === "false") return false;
                throw new Error(`${{input.name}} erwartet true oder false`);
            }}
            return JSON.parse(raw);
        }};
        const displayRunOutput = () => {{
            document.querySelectorAll("[data-run-output]").forEach(node => node.textContent = lastRunOutput);
            document.querySelectorAll("[data-run-title]").forEach(node =>
                node.textContent = `Run: ${{selectedGoal?.label || "Goal"}}`
            );
        }};
        const collectGoalArguments = () => {{
            const values = {{}};
            for (const input of selectedGoal?.inputs || []) {{
                const raw = window.prompt(`Argument ${{input.name}} (${{input.type}}):`, "");
                if (raw === null) return null;
                values[input.name] = parseGoalArgument(input, raw);
            }}
            return values;
        }};
        const prepareSelectedGoal = async () => {{
            if (!selectedGoal) {{ setSaveStatus("Kein Goal ausgewählt", "error"); return false; }}
            if (dirty && currentFile === selectedGoal.path) {{
                await saveWorkspaceFile();
                if (dirty) return false;
                await refreshGoals();
            }}
            return true;
        }};
        const runSelectedGoal = async () => {{
            if (!await prepareSelectedGoal()) return;
            try {{
                const arguments_ = collectGoalArguments();
                if (arguments_ === null) return;
                setSaveStatus(`Führe ${{selectedGoal.label}} aus…`);
                const result = await window.sic.workspace.run(selectedGoal.path, arguments_);
                const value = typeof result.value === "string"
                    ? result.value : JSON.stringify(result.value, null, 2);
                lastRunOutput = `${{result.stdout || ""}}${{result.stdout ? "\n" : ""}}> ${{result.goal}}\n${{value}}`;
                setSaveStatus("Ausführung abgeschlossen", "saved");
            }} catch (error) {{
                lastRunOutput = `[Fehler] ${{error.message}}`;
                setSaveStatus(error.message, "error");
            }}
            const shell = document.querySelector(".ide-shell");
            if (!shell?.classList.contains("bottom-run"))
                document.querySelector('.tool-stripe.left button[title="Run"]')?.click();
            displayRunOutput();
        }};
        const displayDebugState = () => {{
            const event = debugTrace[debugIndex];
            document.querySelectorAll("[data-debug-title]").forEach(node =>
                node.textContent = event ? `Debug: ${{event.name}}` : "Debug"
            );
            document.querySelectorAll("[data-debug-frames]").forEach(list => {{
                list.replaceChildren();
                if (!event) {{
                    const item = document.createElement("li");
                    item.textContent = "Kein aktiver Debug-Lauf";
                    list.append(item);
                    return;
                }}
                debugTrace.slice(0, debugIndex + 1).reverse().forEach((frame, reverseIndex) => {{
                    const item = document.createElement("li");
                    item.textContent = `${{frame.path}}:${{frame.line}} · ${{frame.name}}`;
                    item.classList.toggle("selected", reverseIndex === 0);
                    list.append(item);
                }});
            }});
            document.querySelectorAll("[data-debug-variables]").forEach(container => {{
                container.replaceChildren();
                const variables = event ? {{...event.variables, [event.name]: event.value}} : {{}};
                for (const [name, value] of Object.entries(variables)) {{
                    const row = document.createElement("div");
                    row.className = "debug-row";
                    const key = document.createElement("span");
                    key.className = "debug-name";
                    key.textContent = name;
                    const shown = document.createElement("span");
                    shown.className = "debug-value";
                    shown.textContent = typeof value === "string" ? JSON.stringify(value) : JSON.stringify(value, null, 2);
                    row.append(key, shown);
                    container.append(row);
                }}
            }});
            document.querySelectorAll("[data-debug-log]").forEach(node => {{
                node.textContent = event
                    ? `[debug] pausiert bei ${{event.path}}:${{event.line}}\n[debug] ${{event.name}} = ${{JSON.stringify(event.value)}}`
                    : (debugResult ? `[debug] beendet\n${{debugResult.stdout || ""}}` : "Starte ein Goal mit D.");
            }});
        }};
        const showDebugStep = async index => {{
            if (!debugTrace.length) return;
            debugIndex = Math.max(0, Math.min(index, debugTrace.length - 1));
            const event = debugTrace[debugIndex];
            window.__sicDebugLocation = {{path: event.path, line: event.line}};
            if (currentFile !== event.path) await openWorkspaceFile(event.path, false);
            document.querySelectorAll(".line-number").forEach(node =>
                node.classList.toggle("debug-current", Number(node.dataset.line) === event.line)
            );
            displayDebugState();
        }};
        const startDebugging = async () => {{
            if (!await prepareSelectedGoal()) return;
            try {{
                const arguments_ = collectGoalArguments();
                if (arguments_ === null) return;
                setSaveStatus(`Debugge ${{selectedGoal.label}}…`);
                debugResult = await window.sic.workspace.debug(selectedGoal.path, arguments_);
                debugTrace = debugResult.trace || [];
                let first = debugTrace.findIndex(event =>
                    window.__sicBreakpoints.get(event.path)?.has(event.line)
                );
                if (first < 0) first = 0;
                const shell = document.querySelector(".ide-shell");
                if (!shell?.classList.contains("bottom-debug"))
                    document.querySelector('.tool-stripe.left button[title="Debug"]')?.click();
                if (debugTrace.length) await showDebugStep(first);
                else displayDebugState();
                setSaveStatus("Debugger pausiert", "saved");
            }} catch (error) {{
                debugTrace = [];
                debugResult = null;
                setSaveStatus(error.message, "error");
            }}
        }};
        const continueDebugging = async () => {{
            if (!debugTrace.length) return;
            let next = debugTrace.findIndex((event, index) =>
                index > debugIndex && window.__sicBreakpoints.get(event.path)?.has(event.line)
            );
            if (next < 0) next = debugTrace.length - 1;
            await showDebugStep(next);
            if (next === debugTrace.length - 1) setSaveStatus("Debug-Lauf beendet", "saved");
        }};
        const stopDebugging = () => {{
            debugTrace = [];
            debugIndex = -1;
            debugResult = null;
            window.__sicDebugLocation = null;
            document.querySelectorAll(".line-number.debug-current")
                .forEach(node => node.classList.remove("debug-current"));
            displayDebugState();
            setSaveStatus("Debugger gestoppt");
        }};
        const parentPath = path => path.includes("/") ? path.slice(0, path.lastIndexOf("/")) : "";
        const childPath = (directory, name) => directory ? `${{directory}}/${{name}}` : name;
        const selectedDirectory = () => selectedType === "directory"
            ? selectedPath : parentPath(selectedPath);
        const createWorkspaceFile = async directory => {{
            const name = window.prompt("Name der neuen Datei:", "new.sic");
            if (!name) return;
            const path = childPath(directory, name);
            try {{
                await window.sic.workspace.write(path, "");
                await refreshWorkspace();
                await openWorkspaceFile(path);
            }} catch (error) {{ setSaveStatus(error.message, "error"); }}
        }};
        const createWorkspaceDirectory = async directory => {{
            const name = window.prompt("Name des neuen Ordners:", "new-folder");
            if (!name) return;
            const path = childPath(directory, name);
            try {{
                await window.sic.workspace.mkdir(path);
                selectedPath = path;
                selectedType = "directory";
                await refreshWorkspace();
            }} catch (error) {{ setSaveStatus(error.message, "error"); }}
        }};
        const renameWorkspacePath = async () => {{
            if (!selectedPath) return;
            if (dirty && (currentFile === selectedPath || currentFile.startsWith(`${{selectedPath}}/`))) {{
                window.alert("Bitte die geöffnete Datei vor dem Umbenennen speichern.");
                return;
            }}
            const oldName = selectedPath.split("/").at(-1);
            const newName = window.prompt("Neuer Name:", oldName);
            if (!newName || newName === oldName) return;
            const target = childPath(parentPath(selectedPath), newName);
            try {{
                await window.sic.workspace.rename(selectedPath, target);
                if (currentFile === selectedPath || currentFile.startsWith(`${{selectedPath}}/`)) {{
                    currentFile = target + currentFile.slice(selectedPath.length);
                    window.__sicCurrentFile = currentFile;
                }}
                selectedPath = target;
                await refreshWorkspace();
                updateFileLabels();
            }} catch (error) {{ setSaveStatus(error.message, "error"); }}
        }};
        const deleteWorkspacePath = async () => {{
            if (!selectedPath) return;
            const containsCurrent = currentFile === selectedPath || currentFile.startsWith(`${{selectedPath}}/`);
            const warning = dirty && containsCurrent
                ? "Die Auswahl enthält ungespeicherte Änderungen. Trotzdem endgültig löschen?"
                : `„${{selectedPath}}“ endgültig löschen?`;
            if (!window.confirm(warning)) return;
            try {{
                await window.sic.workspace.delete(selectedPath);
                if (containsCurrent) {{
                    currentFile = "";
                    window.__sicCurrentFile = "";
                    savedContent = "";
                    dirty = false;
                    const editor = sourceEditor();
                    if (editor) {{
                        editor.value = "";
                        editor.dispatchEvent(new Event("input", {{bubbles: true}}));
                    }}
                }}
                selectedPath = "";
                selectedType = "";
                await refreshWorkspace();
            }} catch (error) {{ setSaveStatus(error.message, "error"); }}
        }};
        const contextMenu = () => {{
            let menu = document.querySelector(".workspace-context-menu");
            if (!menu) {{
                menu = document.createElement("div");
                menu.className = "workspace-context-menu";
                menu.hidden = true;
                document.body.append(menu);
            }}
            return menu;
        }};
        const hideWorkspaceMenu = () => {{
            contextMenu().hidden = true;
            document.querySelectorAll(".workspace-more[aria-expanded='true']")
                .forEach(button => button.setAttribute("aria-expanded", "false"));
        }};
        const showWorkspaceMenu = button => {{
            hideWorkspaceMenu();
            selectedPath = button.dataset.workspaceMenuPath;
            selectedType = button.dataset.workspaceMenuType;
            updateFileLabels();
            const menu = contextMenu();
            const actions = selectedType === "directory"
                ? [["new-file", "Neue Datei"], ["new-directory", "Neuer Ordner"], ["rename", "Umbenennen"], ["delete", "Löschen"]]
                : [["rename", "Umbenennen"], ["delete", "Löschen"]];
            menu.replaceChildren(...actions.map(([action, label]) => {{
                const item = document.createElement("button");
                item.type = "button";
                item.dataset.workspaceAction = action;
                item.textContent = label;
                if (action === "delete") item.className = "danger";
                return item;
            }}));
            menu.hidden = false;
            button.setAttribute("aria-expanded", "true");
            const bounds = button.getBoundingClientRect();
            const menuBounds = menu.getBoundingClientRect();
            menu.style.left = `${{Math.max(8, Math.min(bounds.right - menuBounds.width, window.innerWidth - menuBounds.width - 8))}}px`;
            menu.style.top = `${{Math.max(8, Math.min(bounds.bottom + 3, window.innerHeight - menuBounds.height - 8))}}px`;
        }};
        document.addEventListener("input", event => {{
            if (event.target.matches?.(".source-editor") && currentFile)
                setDirty(event.target.value !== savedContent);
        }});
        document.addEventListener("click", event => {{
            const goalOption = event.target.closest("[data-run-goal]");
            if (goalOption) {{
                selectedGoal = workspaceGoals[Number(goalOption.dataset.runGoal)] || null;
                hideRunGoalMenu();
                updateFileLabels();
                return;
            }}
            const runConfig = event.target.closest(".run-config");
            if (runConfig) {{
                showRunGoalMenu(runConfig);
                return;
            }}
            if (event.target.closest(".status-actions .run")) {{
                hideRunGoalMenu();
                runSelectedGoal();
                return;
            }}
            if (event.target.closest(".status-actions .debug")) {{
                hideRunGoalMenu();
                startDebugging();
                return;
            }}
            const debugAction = event.target.closest("[data-debug-action]")?.dataset.debugAction;
            if (debugAction) {{
                if (debugAction === "step") showDebugStep(debugIndex + 1);
                else if (debugAction === "continue") continueDebugging();
                else if (debugAction === "stop") stopDebugging();
                return;
            }}
            hideRunGoalMenu();
            const menuButton = event.target.closest("[data-workspace-menu-path]");
            if (menuButton) {{
                event.preventDefault();
                event.stopPropagation();
                showWorkspaceMenu(menuButton);
                return;
            }}
            const action = event.target.closest("[data-workspace-action]")?.dataset.workspaceAction;
            if (action) {{
                hideWorkspaceMenu();
                if (action === "new-file") createWorkspaceFile(selectedPath);
                else if (action === "new-directory") createWorkspaceDirectory(selectedPath);
                else if (action === "rename") renameWorkspacePath();
                else if (action === "delete") deleteWorkspacePath();
                return;
            }}
            hideWorkspaceMenu();
            const file = event.target.closest("[data-workspace-file]");
            if (file) {{
                selectedPath = file.dataset.workspaceFile;
                selectedType = "file";
                updateFileLabels();
                openWorkspaceFile(file.dataset.workspaceFile);
                return;
            }}
            const pathEntry = event.target.closest("[data-workspace-path]");
            if (pathEntry) {{
                selectedPath = pathEntry.dataset.workspacePath;
                selectedType = pathEntry.dataset.workspaceType;
                updateFileLabels();
                return;
            }}
            if (event.target.closest("[data-workspace-refresh]")) {{ refreshWorkspace(); return; }}
            if (event.target.closest("[data-workspace-new-directory]")) {{
                createWorkspaceDirectory(selectedDirectory());
                return;
            }}
            if (event.target.closest("[data-workspace-new]"))
                createWorkspaceFile(selectedDirectory());
        }});
        document.addEventListener("keydown", event => {{
            if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "s") {{
                event.preventDefault();
                saveWorkspaceFile();
            }}
        }});
        document.addEventListener("sic:bindings-hydrated", () => {{
            renderWorkspace();
            updateFileLabels();
            displayRunOutput();
            displayDebugState();
        }});
        setTimeout(refreshWorkspace, 0);
    }}

    if (window.__sicEditorResizeInstalled) return;
    window.__sicEditorResizeInstalled = true;

    document.addEventListener("pointerdown", event => {{
        const handle = event.target.closest("[data-resize]");
        if (!handle) return;
        const kind = handle.dataset.resize;
        const shell = handle.closest(".ide-shell");
        if (!shell || !properties[kind]) return;
        event.preventDefault();
        handle.classList.add("dragging");
        handle.setPointerCapture?.(event.pointerId);

        const move = moveEvent => {{
            const bounds = shell.getBoundingClientRect();
            let size;
            let minimum = 120;
            let maximum;
            if (kind === "left") {{
                size = moveEvent.clientX - bounds.left - 33;
                maximum = bounds.width * 0.4;
            }} else if (kind === "right") {{
                size = bounds.right - moveEvent.clientX - 33;
                maximum = bounds.width * 0.4;
            }} else if (kind === "bottom") {{
                size = bounds.bottom - moveEvent.clientY - 25;
                minimum = 80;
                maximum = bounds.height * 0.7;
            }} else if (kind === "bottom-split") {{
                const panelBounds = handle.closest(".bottom-panel").getBoundingClientRect();
                size = moveEvent.clientX - panelBounds.left;
                maximum = panelBounds.width - minimum;
            }} else if (kind === "debug-frames") {{
                const debugBounds = handle.closest(".debug-layout").getBoundingClientRect();
                minimum = 90;
                size = moveEvent.clientX - debugBounds.left;
                maximum = debugBounds.width - 220;
            }} else {{
                const debugLayout = handle.closest(".debug-layout");
                const debugBounds = debugLayout.getBoundingClientRect();
                const frameBounds = debugLayout.querySelector(".debug-frames").getBoundingClientRect();
                minimum = 100;
                size = moveEvent.clientX - frameBounds.right;
                maximum = debugBounds.right - frameBounds.right - 100;
            }}
            size = Math.round(Math.max(minimum, Math.min(maximum, size)));
            root.style.setProperty(properties[kind], `${{size}}px`);
            localStorage.setItem(`sic-editor-${{kind}}-size`, String(size));
        }};
        const stop = () => {{
            handle.classList.remove("dragging");
            document.removeEventListener("pointermove", move);
            document.removeEventListener("pointerup", stop);
            document.removeEventListener("pointercancel", stop);
        }};
        document.addEventListener("pointermove", move);
        document.addEventListener("pointerup", stop);
        document.addEventListener("pointercancel", stop);
    }});
}})();
</script>
"""

var source: String = "goal greeting: String = prefix + name\nlet prefix = \"Hallo \"\nlet name = \"SIC\""
var leftTool: String = "project"
var rightTool: String = ""
var bottomTool: String = ""
var rightBottomTool: String = ""
